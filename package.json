    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-moveable": "0.56.0"
  },
  "devDependencies": {
    "@mmote/niimbluelib": "0.47.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
